{
  "name": "@ylcc/napi-ffi",
  "version": "0.0.100",
  "description": "Template project for writing node package with napi-rs",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "url": "git+ssh://git@github.com/napi-rs/package-template-pnpm.git",
    "type": "git"
  },
  "license": "MIT",
  "keywords": [
    "napi-rs",
    "NAPI",
    "N-API",
    "Rust",
    "node-addon",
    "node-addon-api"
  ],
  "files": [
    "index.d.ts",
    "index.js",
    "native.d.ts",
    "native.js",
    "lib"
  ],
  "napi": {
    "binaryName": "napi-ffi",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "i686-pc-windows-msvc",
      "armv7-unknown-linux-gnueabihf",
      "aarch64-linux-android",
      "x86_64-unknown-freebsd",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "armv7-linux-androideabi"
    ]
  },
  "engines": {
    "node": ">= 10"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node --experimental-ffi --import @oxc-node/core/register benchmark/bench.ts",
    "build": "napi build --platform --release --js native.js --dts native.d.ts",
    "build:debug": "napi build --platform --js native.js --dts native.d.ts",
    "build:ffi-fixture": "mkdir -p __test__/fixture_library/build/Debug __test__/fixtures/build && cc -shared -fPIC __test__/fixture_library/ffi_test_library.c -o __test__/fixture_library/build/Debug/ffi_test_library.so && cp __test__/fixture_library/build/Debug/ffi_test_library.so __test__/fixtures/build/ffi_test_library.so",
    "format": "run-p format:prettier format:rs format:toml",
    "format:prettier": "prettier . -w",
    "format:toml": "taplo format",
    "format:rs": "cargo fmt",
    "lint": "oxlint",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "pnpm build:ffi-fixture && ava",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.6.2",
    "@oxc-node/core": "^0.1.0",
    "@taplo/cli": "^0.7.0",
    "@types/node": "^25.9.1",
    "ava": "^8.0.0",
    "chalk": "^5.6.2",
    "ffi-rs": "^1.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.14.0",
    "prettier": "^3.6.2",
    "tinybench": "^6.0.0",
    "typescript": "^6.0.0"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|ts|tsx|yml|yaml|md|json)": [
      "prettier --write"
    ],
    "*.toml": [
      "taplo format"
    ]
  },
  "ava": {
    "files": [
      "__test__/**/*.spec.ts"
    ],
    "extensions": [
      "ts"
    ],
    "timeout": "2m",
    "failWithoutAssertions": false,
    "workerThreads": false,
    "environmentVariables": {
      "TS_NODE_PROJECT": "./tsconfig.json"
    },
    "nodeArguments": [
      "--expose-gc",
      "--import",
      "@oxc-node/core/register"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  },
  "packageManager": "pnpm@11.1.2"
}
